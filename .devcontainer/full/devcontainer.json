// Desktop devcontainer: everything in `base` plus rviz2, rqt, PlotJuggler, xacro.
// Needs an X server on the host. Run `xhost +local:` once before opening.
{
    "name": "modern-ros2 full (rviz, rqt, PlotJuggler)",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "target": "full"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/modern-ros2,type=bind",
    "workspaceFolder": "/workspaces/modern-ros2",
    "remoteUser": "vscode",
    "runArgs": [
        "--network=host",
        "--ipc=host",
        "--privileged"
        // Uncomment for NVIDIA GPU passthrough (needs the NVIDIA Container Toolkit):
        // , "--gpus=all"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    ],
    "containerEnv": {
        "WS": "${containerWorkspaceFolder}",
        "DISPLAY": "${localEnv:DISPLAY}",
        // Qt apps (rviz2, rqt) misrender over a shared X socket without this.
        "QT_X11_NO_MITSHM": "1"
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ranch-hand-robotics.rde-pack",
                "ms-python.python",
                "ms-vscode.cpptools",
                "eamodio.gitlens",
                "anthropic.claude-code",
                "bierner.markdown-mermaid"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    }
}
