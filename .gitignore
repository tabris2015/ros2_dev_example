# Colcon build artifacts at the workspace root, and stray per-package builds
# under src/. Not a bare `build/`: that would also ignore .claude/skills/build.
/build/
/install/
/log/
src/**/build/
src/**/install/
src/**/log/

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# C++
*.o
*.so
*.a

# IDE
.vscode/.browse.c_cpp.db*
.vscode/ipch/

# Per-user Claude Code permissions
.claude/settings.local.json

# Downloaded model weights
/models/

# OS
.DS_Store
